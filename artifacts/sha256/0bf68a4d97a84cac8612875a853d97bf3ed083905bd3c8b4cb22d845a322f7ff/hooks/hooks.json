{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "wl hook session-start", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "wl hook pre-tool-use", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "wl hook post-tool-use", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "wl hook stop", "timeout": 10 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "wl hook session-end", "timeout": 10 }]
      }
    ]
  }
}
